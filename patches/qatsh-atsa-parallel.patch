+/* ATSA_PARALLEL: read-only analysis context shared by every frame worker. */
+typedef struct {
+  ANARGS *anargs;
+  double *in_samps;
+  int sflen;
+  double *window, *dwindow, norm;
+  int M_2, first_point;
+  const double *mlobe_gain;
+  int mlobe_res;
+  /* multi-resolution long-window context (valid only when anargs->multi_res) */
+  double *lwindow, *ldwindow, lnorm;
+  const double *lmlobe_gain;
+  int lwin_size, lM_2, lfirst_point, crossover_bin;
+  int *win_samps;
+  /* outputs, one slot per frame */
+  ATS_PEAK **frame_peaks;
+  int *frame_npeaks;
+} FrameCtx;
+
+/* ATSA_PARALLEL: per-worker FFT scratch (one set per thread). */
+typedef struct {
+  ATS_FFT fft, dfft;
+  double *packr, *packi, *fsamps;
+  ATS_FFT lfft, ldfft;
+  double *lpackr, *lpacki, *lfsamps;
+} FrameScratch;
+
+static void frame_scratch_alloc(FrameScratch *s, const FrameCtx *c)
+{
+  int fft_size = c->anargs->fft_size;
+  s->fft.size = s->dfft.size = fft_size;
+  s->fft.rate = s->dfft.rate = c->anargs->srate;
+  s->fft.fdr  = (double *)malloc(fft_size * sizeof(double));
+  s->fft.fdi  = (double *)malloc(fft_size * sizeof(double));
+  s->dfft.fdr = (double *)malloc(fft_size * sizeof(double));
+  s->dfft.fdi = (double *)malloc(fft_size * sizeof(double));
+  s->packr    = (double *)malloc(fft_size * sizeof(double));
+  s->packi    = (double *)malloc(fft_size * sizeof(double));
+  s->fsamps   = (double *)malloc(c->anargs->win_size * sizeof(double));
+  s->lpackr = s->lpacki = s->lfsamps = NULL;
+  s->lfft.fdr = s->lfft.fdi = s->ldfft.fdr = s->ldfft.fdi = NULL;
+  if (c->anargs->multi_res) {
+    s->lfft.size = s->ldfft.size = fft_size;
+    s->lfft.rate = s->ldfft.rate = c->anargs->srate;
+    s->lfft.fdr  = (double *)malloc(fft_size * sizeof(double));
+    s->lfft.fdi  = (double *)malloc(fft_size * sizeof(double));
+    s->ldfft.fdr = (double *)malloc(fft_size * sizeof(double));
+    s->ldfft.fdi = (double *)malloc(fft_size * sizeof(double));
+    s->lpackr  = (double *)malloc(fft_size * sizeof(double));
+    s->lpacki  = (double *)malloc(fft_size * sizeof(double));
+    s->lfsamps = (double *)malloc(c->lwin_size * sizeof(double));
+  }
+}
+
+static void frame_scratch_free(FrameScratch *s)
+{
+  free(s->fft.fdr);  free(s->fft.fdi);
+  free(s->dfft.fdr); free(s->dfft.fdi);
+  free(s->packr);    free(s->packi);   free(s->fsamps);
+  free(s->lfft.fdr);  free(s->lfft.fdi);
+  free(s->ldfft.fdr); free(s->ldfft.fdi);
+  free(s->lpackr);    free(s->lpacki);  free(s->lfsamps);
+}
+
+/* ATSA_PARALLEL: independent per-frame work — windowing, packed FFT, peak
+ * detection, DDM slopes, multi-res long-window pass and SMR. Writes only this
+ * frame's slot in frame_peaks/frame_npeaks, so frames may run concurrently. */
+static void process_one_frame(const FrameCtx *c, FrameScratch *s, int frame_n)
+{
+  ANARGS *anargs = c->anargs;
+  int k, fft_size = anargs->fft_size, win_size = anargs->win_size;
+  int filptr = (anargs->first_smp - c->M_2) + frame_n * anargs->hop_smp;
+  int peaks_size = 0;
+  ATS_PEAK *peaks = NULL;
+  /* install this thread's main-lobe gain table (thread-local) */
+  set_mainlobe_gain(c->mlobe_gain, c->mlobe_res);
+  for (k = 0; k < fft_size; k++) s->packr[k] = s->packi[k] = 0.0;
+  for (k = 0; k < win_size; k++) {
+    if ((filptr >= 0) && (filptr < c->sflen)) {
+      int idx = (k + c->first_point) % fft_size;
+      s->packr[idx] = c->window[k]  * c->in_samps[filptr];
+      s->packi[idx] = c->dwindow[k] * c->in_samps[filptr];
+      s->fsamps[k]  = c->in_samps[filptr];
+    } else {
+      s->fsamps[k] = 0.0;
+    }
+    filptr++;
+  }
+  fft(s->packr, s->packi, fft_size, 1);
+  rfft_unpack(s->packr, s->packi, fft_size, &s->fft, &s->dfft);
+  {
+    int def_low = anargs->multi_res ? c->crossover_bin + 1 : anargs->lowest_bin;
+    peaks = peak_detection(&s->fft, &s->dfft, def_low, anargs->highest_bin,
+                           anargs->lowest_mag, c->norm, &peaks_size);
+  }
+  if (peaks != NULL)
+    for (k = 0; k < peaks_size; k++)
+      ddm_slopes(s->fsamps, c->window, c->dwindow, win_size, anargs->srate,
+                 peaks[k].frq, (double)c->M_2, &peaks[k].frq_slope, &peaks[k].amp_slope);
+  if (anargs->multi_res && c->crossover_bin >= anargs->lowest_bin) {
+    int lfilptr = c->win_samps[frame_n] - c->lM_2;
+    ATS_PEAK *lpeaks = NULL;
+    int lpeaks_size = 0;
+    for (k = 0; k < fft_size; k++) s->lpackr[k] = s->lpacki[k] = 0.0;
+    for (k = 0; k < c->lwin_size; k++) {
+      if ((lfilptr >= 0) && (lfilptr < c->sflen)) {
+        int lidx = (k + c->lfirst_point) % fft_size;
+        s->lpackr[lidx] = c->lwindow[k]  * c->in_samps[lfilptr];
+        s->lpacki[lidx] = c->ldwindow[k] * c->in_samps[lfilptr];
+        s->lfsamps[k]   = c->in_samps[lfilptr];
+      } else {
+        s->lfsamps[k] = 0.0;
+      }
+      lfilptr++;
+    }
+    fft(s->lpackr, s->lpacki, fft_size, 1);
+    rfft_unpack(s->lpackr, s->lpacki, fft_size, &s->lfft, &s->ldfft);
+    set_mainlobe_gain(c->lmlobe_gain, c->mlobe_res);
+    lpeaks = peak_detection(&s->lfft, &s->ldfft, anargs->lowest_bin,
+                            c->crossover_bin, anargs->lowest_mag, c->lnorm, &lpeaks_size);
+    set_mainlobe_gain(c->mlobe_gain, c->mlobe_res);
+    if (lpeaks != NULL) {
+      for (k = 0; k < lpeaks_size; k++)
+        ddm_slopes(s->lfsamps, c->lwindow, c->ldwindow, c->lwin_size, anargs->srate,
+                   lpeaks[k].frq, (double)c->lM_2, &lpeaks[k].frq_slope, &lpeaks[k].amp_slope);
+      for (k = 0; k < lpeaks_size; k++)
+        peaks = push_peak(&lpeaks[k], peaks, &peaks_size);
+      free(lpeaks);
+    }
+  }
+  if (peaks != NULL) evaluate_smr(peaks, peaks_size);
+  c->frame_peaks[frame_n] = peaks;
+  c->frame_npeaks[frame_n] = peaks_size;
+}
+
+#ifdef ATSA_HAVE_THREADS
+/* ATSA_PARALLEL: a contiguous frame range assigned to one worker thread. */
+typedef struct {
+  const FrameCtx *ctx;
+  FrameScratch *scratch;
+  int start, end;
+  atomic_int *done;
+} FrameJob;
+
+static void *frame_worker(void *arg)
+{
+  FrameJob *j = (FrameJob *)arg;
+  ANARGS *anargs = j->ctx->anargs;
+  int throttle = anargs->frames / 200;
+  int f;
+  if (throttle < 1) throttle = 1;
+  for (f = j->start; f < j->end; f++) {
+    process_one_frame(j->ctx, j->scratch, f);
+    if (anargs->progress_cb != NULL) {
+      int n = atomic_fetch_add(j->done, 1) + 1;
+      if (n % throttle == 0)
+        anargs->progress_cb(anargs->progress_user,
+                            0.75 * (double)n / (double)anargs->frames);
+    }
+  }
+  return NULL;
+}
+#endif
+
+/* ATSA_PARALLEL: run the independent per-frame stage over all frames, using as
+ * many worker threads as there are cores (serial when threads are unavailable
+ * or only one frame's worth of work). Fills c->frame_peaks / c->frame_npeaks. */
+static void run_frame_stage(const FrameCtx *c)
+{
+  int frames = c->anargs->frames;
+#ifdef ATSA_HAVE_THREADS
+  long ncpu = sysconf(_SC_NPROCESSORS_ONLN);
+  int nthreads = (ncpu > 1) ? (int)ncpu : 1;
+  if (nthreads > frames) nthreads = frames;
+  if (nthreads > 32) nthreads = 32;
+  if (nthreads > 1) {
+    pthread_t *tids = (pthread_t *)malloc(nthreads * sizeof(pthread_t));
+    FrameJob *jobs = (FrameJob *)malloc(nthreads * sizeof(FrameJob));
+    FrameScratch *scratch = (FrameScratch *)malloc(nthreads * sizeof(FrameScratch));
+    atomic_int done;
+    int t, base = frames / nthreads, rem = frames % nthreads, next = 0;
+    atomic_init(&done, 0);
+    for (t = 0; t < nthreads; t++) {
+      int cnt = base + (t < rem ? 1 : 0);
+      frame_scratch_alloc(&scratch[t], c);
+      jobs[t].ctx = c;
+      jobs[t].scratch = &scratch[t];
+      jobs[t].start = next;
+      jobs[t].end = next + cnt;
+      jobs[t].done = &done;
+      next += cnt;
+    }
+    for (t = 0; t < nthreads; t++) pthread_create(&tids[t], NULL, frame_worker, &jobs[t]);
+    for (t = 0; t < nthreads; t++) pthread_join(tids[t], NULL);
+    for (t = 0; t < nthreads; t++) frame_scratch_free(&scratch[t]);
+    free(scratch); free(jobs); free(tids);
+    return;
+  }
+#endif
+  {
+    /* serial fallback */
+    FrameScratch scratch;
+    int f, throttle = frames / 200;
+    if (throttle < 1) throttle = 1;
+    frame_scratch_alloc(&scratch, c);
+    for (f = 0; f < frames; f++) {
+      process_one_frame(c, &scratch, f);
+      if (c->anargs->progress_cb != NULL && f % throttle == 0)
+        c->anargs->progress_cb(c->anargs->progress_user,
+                               0.75 * (double)f / (double)frames);
+    }
+    frame_scratch_free(&scratch);
+  }
+}
