+void build_mainlobe_gain(const double *window, int win_size, int fft_size, double *table, int res)
+{
+  int n;
+  double dc = 0.0;
+  for (n = 0; n < win_size; n++) dc += window[n];
+  if (dc <= 0.0) dc = 1.0;
+#ifdef ATSA_HAVE_THREADS
+  {
+    long ncpu = sysconf(_SC_NPROCESSORS_ONLN);
+    int nthreads = (ncpu > 1) ? (int)ncpu : 1;
+    if (nthreads > res) nthreads = res;
+    if (nthreads > 32) nthreads = 32;
+    if (nthreads > 1) {
+      pthread_t *tids = (pthread_t *)malloc(nthreads * sizeof(pthread_t));
+      MainlobeJob *jobs = (MainlobeJob *)malloc(nthreads * sizeof(MainlobeJob));
+      int t, base = res / nthreads, rem = res % nthreads, next = 0;
+      for (t = 0; t < nthreads; t++) {
+        int cnt = base + (t < rem ? 1 : 0);
+        jobs[t].window = window; jobs[t].win_size = win_size;
+        jobs[t].fft_size = fft_size; jobs[t].res = res;
+        jobs[t].table = table; jobs[t].dc = dc;
+        jobs[t].lo = next; jobs[t].hi = next + cnt;
+        next += cnt;
+      }
+      for (t = 0; t < nthreads; t++) pthread_create(&tids[t], NULL, mainlobe_worker, &jobs[t]);
+      for (t = 0; t < nthreads; t++) pthread_join(tids[t], NULL);
+      free(jobs); free(tids);
+      return;
+    }
+  }
+#endif
+  mainlobe_gain_range(window, win_size, fft_size, table, res, dc, 0, res);
+}
