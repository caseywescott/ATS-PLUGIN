+/* ATSA_RFFT_PACK: split one packed complex spectrum into two real-input spectra.
+ * The analysis window FFT and the derivative-window FFT operate on the SAME real
+ * samples; instead of two real FFTs we pack them into one complex transform
+ *   Z = FFT(main + j*deriv)
+ * and recover each via Hermitian symmetry. For a real sequence x, FFT(x) is
+ * conjugate-symmetric (X[N-k] = conj(X[k])) under either +-j convention, so
+ *   FFT(main)[k]  = (Z[k] + conj(Z[N-k])) / 2
+ *   FFT(deriv)[k] = (Z[k] - conj(Z[N-k])) / (2j)
+ * with N-k taken mod fft_size. This is mathematically exact (no approximation);
+ * it differs from two separate FFTs only in floating-point rounding. out_a
+ * receives FFT(main), out_b receives FFT(deriv); all `size` bins are filled so
+ * downstream bin/pair reads (peak_detection, reassign_frq) are unaffected. */
+static void rfft_unpack(const double *zr, const double *zi, int size,
+                        ATS_FFT *out_a, ATS_FFT *out_b)
+{
+  int k;
+  for (k = 0; k < size; k++) {
+    int m = (size - k) % size;
+    double zkr = zr[k], zki = zi[k];
+    double zmr = zr[m], zmi = zi[m];
+    /* (Z[k] + conj(Z[m]))/2 */
+    out_a->fdr[k] = 0.5 * (zkr + zmr);
+    out_a->fdi[k] = 0.5 * (zki - zmi);
+    /* (Z[k] - conj(Z[m]))/(2j) = (1/2)( (zki+zmi) + j(zmr-zkr) ) */
+    out_b->fdr[k] = 0.5 * (zki + zmi);
+    out_b->fdi[k] = 0.5 * (zmr - zkr);
+  }
+}
