+/* ATSA_TRACKING_DS: map a candidate peak back to its index in the sorted peaks array. */
+static int peak_index_of(const ATS_PEAK *peaks, int peaks_size, const ATS_PEAK *candidate)
+{
+  int i;
+  for (i = 0; i < peaks_size; i++)
+    if (peaks[i].frq == candidate->frq && peaks[i].amp == candidate->amp && peaks[i].track == candidate->track)
+      return i;
+  return -1;
+}
