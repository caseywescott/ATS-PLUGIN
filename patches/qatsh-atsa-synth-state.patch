+/* ATSA_SYNTH_STATE: mutex-guarded one-shot fill of sound->res from band_energy. */
+#if defined(ATSA_HAVE_THREADS)
+static pthread_mutex_t atsa_res_prefill_mu = PTHREAD_MUTEX_INITIALIZER;
+static ATS_SOUND *atsa_res_prefilled_sound = NULL;
+#endif
 
+void atsa_prefill_partial_residual(ATS_SOUND *sound)
+{
+  int f;
+  if (sound == NULL || sound->band_energy == NULL)
+    return;
+#if defined(ATSA_HAVE_THREADS)
+  pthread_mutex_lock(&atsa_res_prefill_mu);
+  if (atsa_res_prefilled_sound != sound) {
+    for (f = 0; f < sound->frames; f++)
+      band_energy_to_res(sound, f);
+    atsa_res_prefilled_sound = sound;
+  }
+  pthread_mutex_unlock(&atsa_res_prefill_mu);
+#else
+  for (f = 0; f < sound->frames; f++)
+    band_energy_to_res(sound, f);
+#endif
+}
