+/* ATSA_QIFFT_AMP: window-gain (bias-corrected QIFFT) amplitude estimation.
+ * The dB-parabolic peak height carries a window- and offset-dependent bias; the
+ * true amplitude of a stationary sinusoid is the raw peak-bin magnitude divided
+ * by the analytic window main-lobe gain G(delta) at the sub-bin offset delta.
+ * The tracker precomputes G over delta in [-0.5, 0.5] into a file-static table
+ * (so peak_detection keeps its signature) and installs it before the frame
+ * loop. When the table is absent the legacy parabolic amplitude is kept. */
+static const double *qifft_mlobe_gain = NULL; /* table over delta in [-0.5,0.5] */
+static int qifft_mlobe_res = 0;               /* number of table samples */
+void set_mainlobe_gain(const double *table, int res);
+void build_mainlobe_gain(const double *window, int win_size, int fft_size, double *table, int res);
+static double mlobe_lookup(double delta);
