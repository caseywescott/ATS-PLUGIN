 #define LIN3_INTERP(x, yp, yc, yn) \
  (((x) < .5) ? ((yc) + (yp)) / 2 + x * ((yc) - (yp)) : (3*(yc) - (yn)) / 2 + x * ((yn) - (yc)))
 
+/* ATSA_DDM_SLOPES: cubic frequency interpolation over the current frame x in
+ * [0,1]. It passes through the SAME three control points LIN3 nails -- f(0)=
+ * (fp+fc)/2, f(.5)=fc, f(1)=(fc+fn)/2 -- but replaces LIN3's kinked center slope
+ * with the DDM-measured chirp S (Hz per frame). Solving a+bx+cx^2+ex^3 for those
+ * four constraints: e=4(D1-S), b=4*D2-D1+e/2, c=D1-e-b, a=(fp+fc)/2, with
+ * D1=(fn-fp)/2 and D2=(fc-fp)/2. When S equals the linear-implied slope (fn-fp)/2
+ * the cubic collapses to LIN3 exactly, so curvature is added only for genuine
+ * sub-hop frequency motion (vibrato turning points).
+ *
+ * Overshoot limiter (Fritsch-Carlson 1980): the raw DDM chirp is unreliable on
+ * weak/near-stationary partials -- measured up to ~5x the inter-frame chord and
+ * ~900 Hz over a 50 ms frame, which the bare cubic renders as audible spurious
+ * sweeps. Bounding the center tangent to 3*min(|secantL|,|secantR|) (the two
+ * half-frame secants fc-fp and fn-fc) keeps the interpolant within the data
+ * envelope: on a steady partial both secants ~0 so S is clamped toward 0 and the
+ * cubic falls back to LIN3, while genuine vibrato flanks (sizable secants) retain
+ * their curvature. Linear motion (S = chord) is well under the cap, so the
+ * LIN3-exact reduction is preserved. */
+#define CUBIC_FREQ_COEFFS(use, fp, fc, fn, S, A, B, C, E) do { \
+    if (use) { double F0=((fp)+(fc))*.5, D1=((fn)-(fp))*.5, D2=((fc)-(fp))*.5; \
+      double sL=(fc)-(fp), sR=(fn)-(fc); \
+      double mn=(fabs(sL)<fabs(sR)?fabs(sL):fabs(sR)), Slim=3.0*mn, Sc=(S); \
+      if(Sc>Slim) Sc=Slim; else if(Sc<-Slim) Sc=-Slim; \
+      (E)=4.*(D1-Sc); (B)=4.*D2-D1+.5*(E); (C)=D1-(E)-(B); (A)=F0; } } while(0)
+#define CUBIC_FREQ_EVAL(x, A, B, C, E) ((A) + (x)*((B) + (x)*((C) + (x)*(E))))
