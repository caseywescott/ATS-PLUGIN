 /* private function prototypes */
 int compute_frames(ANARGS *anargs);
+/* ATSA_DDM_SLOPES: order-2 Distribution Derivative Method slope estimator */
+static void ddm_slopes(const double *samps, const double *window, const double *dwindow,
+                       int win_size, int srate, double f0, double n_c,
+                       double *frq_slope, double *amp_slope);
+
+/* ddm_slopes
+ * ==========
+ * ATSA_DDM_SLOPES: estimate the within-frame frequency slope (chirp, Hz/s) and
+ * amplitude log-slope (nepers/s) of the partial near f0, by fitting the windowed
+ * segment to s(tau) = exp(b0 + b1*tau + b2*tau^2) (tau = sample offset from the
+ * window center n_c). Solves the 2x2 complex DDM system from time-domain inner
+ * products with {h, tau h, tau^2 h, h', tau h'}; chirp = Im(b2)*sr^2/pi,
+ * amp-slope = Re(b1)*sr. Validated against the harness prototype
+ * (tests/estimator_accuracy_test.c): 0.01% chirp-rate error on a linear chirp,
+ * exact AM-slope recovery. Inner products use the textbook -j convention
+ * (self-contained; independent of qatsh's +j fft). */
+static void ddm_slopes(const double *samps, const double *window, const double *dwindow,
+                       int win_size, int srate, double f0, double n_c,
+                       double *frq_slope, double *amp_slope)
+{
+  int n;
+  double w0 = TWOPI * f0 / (double)srate;
+  double p0r=0,p0i=0,p1r=0,p1i=0,p2r=0,p2i=0,dr=0,di=0,dtr=0,dti=0;
+  *frq_slope = 0.0;
+  *amp_slope = 0.0;
+  for (n=0; n<win_size; n++) {
+    double tau = (double)n - n_c;
+    double ph = -w0 * tau;
+    double c = cos(ph), sn = sin(ph);   /* e^{-j w0 tau} = c + j sn */
+    double sh = samps[n] * window[n];   /* s * h  */
+    double sdh = samps[n] * dwindow[n]; /* s * h' */
+    p0r += sh*c;          p0i += sh*sn;
+    p1r += sh*tau*c;      p1i += sh*tau*sn;
+    p2r += sh*tau*tau*c;  p2i += sh*tau*tau*sn;
+    dr  += sdh*c;         di  += sdh*sn;
+    dtr += sdh*tau*c;     dti += sdh*tau*sn;
+  }
+  {
+    /* [a b; c d][b1;b2] = [e;f], a=P0,b=2P1,c=P1,d=2P2,
+       e=-D + j w0 P0, f=-P0 - DT + j w0 P1 */
+    double ar=p0r, ai=p0i, br=2*p1r, bi=2*p1i, cr=p1r, ci=p1i, dr2=2*p2r, di2=2*p2i;
+    double er=-dr - w0*p0i, ei=-di + w0*p0r;
+    double fr=-p0r - dtr - w0*p1i, fi=-p0i - dti + w0*p1r;
+    double detr=(ar*dr2 - ai*di2) - (br*cr - bi*ci);
+    double deti=(ar*di2 + ai*dr2) - (br*ci + bi*cr);
+    double detm=detr*detr + deti*deti;
+    if (detm > 0.0) {
+      double edr=er*dr2 - ei*di2, edi=er*di2 + ei*dr2;       /* e*d */
+      double bfr=br*fr - bi*fi, bfi=br*fi + bi*fr;           /* b*f */
+      double n1r=edr - bfr, n1i=edi - bfi;                   /* e*d - b*f */
+      double afr=ar*fr - ai*fi, afi=ar*fi + ai*fr;           /* a*f */
+      double ecr=er*cr - ei*ci, eci=er*ci + ei*cr;           /* e*c */
+      double n2r=afr - ecr, n2i=afi - eci;                   /* a*f - e*c */
+      double b1r=(n1r*detr + n1i*deti) / detm;               /* Re(b1) */
+      double b2i=(n2i*detr - n2r*deti) / detm;               /* Im(b2) */
+      double sr=(double)srate;
+      *frq_slope = b2i * sr * sr / PI;   /* 2*Im(b2)/(2pi) * sr^2 -> Hz/s */
+      *amp_slope = b1r * sr;             /* Re(b1) 1/sample -> nepers/s */
+    }
+  }
+}
 
