+/* ATSA_IFFT_SYNTH ====================================================
+ * Overlap-add inverse-FFT additive synthesis (Rodet & Depalle 1992).
+ * Each frame's deterministic partials are deposited into one spectrum as
+ * Hann main-lobes (0.5,-0.25,-0.25 Dirichlet kernels at the fractional bin),
+ * inverse-FFT'd into one windowed grain, and overlap-added on the uniform
+ * analysis grid. Cost is O(frames * (partials*lobe + N log N)) -- independent
+ * of synthesis length per partial, flat in partial count beyond the deposit.
+ */
+
+/* Normalized Dirichlet (periodic-sinc) kernel of an N-point rectangular
+ * window evaluated at fractional bin offset x; Dir(0)=1. The exp() term is the
+ * 0-indexed window-DFT phase. */
+static void ats_dir_kernel(double x, int N, double *re, double *im)
+{
+  double mag, ph, den;
+  if (fabs(x) < 1.0e-9) {
+    mag = 1.0;
+  } else {
+    den = (double)N * sin(M_PI * x / (double)N);
+    mag = (fabs(den) < 1.0e-12) ? 1.0 : sin(M_PI * x) / den;
+  }
+  ph = M_PI * x * (double)(N - 1) / (double)N;
+  *re = mag * cos(ph);
+  *im = mag * sin(ph);
+}
+
+void do_synthesis_ifft(ATS_SOUND *ats_sound, SPARAMS *sparams, int *selected,
+                       double **out_samps, int *n_out_samps)
+{
+  int F = ats_sound->frames;
+  int P = ats_sound->partials;
+  int todo, H, N, half, f, d, k, n, kk, kc, base, g, b_band;
+  int has_residual;
+  double hop_sec, *out, *nrm, *re, *im, *hann;
+  const int Kw = 6; /* Hann main-lobe deposit half-width (bins) */
+
+  *out_samps = NULL;
+  *n_out_samps = 0;
+  if (F < 1 || P < 1 || sparams->sr <= 0.0)
+    return;
+
+  todo = (int)floor(ats_sound->dur * sparams->sr + 0.5);
+  if (todo <= 0)
+    return;
+
+  hop_sec = (F > 1) ? (ats_sound->time[0][1] - ats_sound->time[0][0]) : ats_sound->dur;
+  H = (int)floor(hop_sec * sparams->sr + 0.5);
+  if (H < 1) H = 1;
+  N = (int)ppp2((unsigned int)(2 * H));
+  if (N < 8) N = 8;
+  half = N / 2;
+
+  out  = (double*)calloc((size_t)todo, sizeof(double));
+  nrm  = (double*)calloc((size_t)todo, sizeof(double));
+  re   = (double*)malloc((size_t)N * sizeof(double));
+  im   = (double*)malloc((size_t)N * sizeof(double));
+  hann = (double*)malloc((size_t)N * sizeof(double));
+  for (n = 0; n < N; ++n)
+    hann[n] = 0.5 - 0.5 * cos(2.0 * M_PI * (double)n / (double)N);
+
+  for (f = 0; f < F; ++f) {
+    int center = (int)floor(ats_sound->time[0][f] * sparams->sr + 0.5);
+    memset(re, 0, (size_t)N * sizeof(double));
+    memset(im, 0, (size_t)N * sizeof(double));
+
+    for (d = 0; d < P; ++d) {
+      double a, freq, bbin, phi, phig, cr, ci;
+      if (sparams->allorsel && selected && !selected[d])
+        continue;
+      a = ats_sound->amp[d][f] * sparams->amp;
+      if (!(a > 0.0))
+        continue;
+      freq = ats_sound->frq[d][f] * sparams->frec;
+      if (freq <= 0.0 || freq >= 0.5 * sparams->sr)
+        continue;
+      bbin = freq * (double)N / sparams->sr;
+      phi  = (sparams->upha && ats_sound->pha) ? ats_sound->pha[d][f] : 0.0;
+      /* phase is defined at the grain center (n=N/2); shift to the n=0 origin
+         used by the Dirichlet phase term. */
+      phig = phi - M_PI * bbin;
+      /* qatsh forward FFT is +j: the lobe near bin b carries e^{-j phig}; the
+         Hermitian mirror reconstructs the e^{+j phig} image near N-b. */
+      cr = cos(phig);
+      ci = -sin(phig);
+      kc = (int)floor(bbin + 0.5);
+      for (kk = kc - Kw; kk <= kc + Kw; ++kk) {
+        double x, kr = 0.0, ki = 0.0, dr, di, tr, ti, vr, vi;
+        if (kk < 1 || kk > half)
+          continue;
+        x = (double)kk - bbin;
+        ats_dir_kernel(x,       N, &dr, &di); kr += 0.5  * dr; ki += 0.5  * di;
+        ats_dir_kernel(x - 1.0, N, &tr, &ti); kr -= 0.25 * tr; ki -= 0.25 * ti;
+        ats_dir_kernel(x + 1.0, N, &tr, &ti); kr -= 0.25 * tr; ki -= 0.25 * ti;
+        /* (a/2) * e^{j phig} * K_hann(x) */
+        vr = 0.5 * a * (cr * kr - ci * ki);
+        vi = 0.5 * a * (cr * ki + ci * kr);
+        re[kk] += vr;
+        im[kk] += vi;
+      }
+    }
+
+    /* Hermitian-symmetrize so the inverse transform is real. */
+    for (k = 1; k < half; ++k) {
+      re[N - k] =  re[k];
+      im[N - k] = -im[k];
+    }
+    im[0] = 0.0;
+    im[half] = 0.0;
+
+    fft(re, im, N, -1); /* inverse (qatsh forward is +1) */
+
+    base = center - half;
+    for (n = 0; n < N; ++n) {
+      g = base + n;
+      if (g < 0 || g >= todo)
+        continue;
+      /* The Dirichlet kernel is normalized (Dir(0)=1), which already absorbs the
+         unscaled inverse FFT's factor of N, so no extra 1/N here. The grain is
+         Hann-windowed by the deposit. */
+      out[g] += re[n];
+      nrm[g] += hann[n];
+    }
+  }
+
+  for (n = 0; n < todo; ++n)
+    if (nrm[n] > 1.0e-9)
+      out[n] /= nrm[n];
+
+  /* Residual band-noise: same model as the oscillator path, uniform grid. */
+  srand(ATSA_SYNTH_RANDOM_SEED);
+  has_residual = ats_sound->band_energy != NULL;
+  if (has_residual && sparams->ramp > 0.0 && sparams->amp != 0.0) {
+    RANDI *rb = (RANDI*)malloc((size_t)ATSA_CRITICAL_BANDS * sizeof(RANDI));
+    double *bcent = (double*)malloc((size_t)ATSA_CRITICAL_BANDS * sizeof(double));
+    double *osc = (double*)calloc((size_t)ATSA_CRITICAL_BANDS, sizeof(double));
+    for (f = 0; f < F; ++f)
+      band_energy_to_res(ats_sound, f);
+    for (b_band = 0; b_band < ATSA_CRITICAL_BANDS; ++b_band) {
+      bcent[b_band] = (ATSA_CRITICAL_BAND_EDGES[b_band + 1] + ATSA_CRITICAL_BAND_EDGES[b_band]) / 2.0;
+      randi_setup(sparams->sr,
+                  ATSA_CRITICAL_BAND_EDGES[b_band + 1] - ATSA_CRITICAL_BAND_EDGES[b_band],
+                  &rb[b_band]);
+    }
+    for (n = 0; n < todo; ++n) {
+      double t = (double)n / sparams->sr;
+      double ff = t / (hop_sec > 0.0 ? hop_sec : 1.0);
+      int fi = (int)floor(ff);
+      double frac = ff - (double)fi;
+      int fn = fi + 1;
+      if (fi < 0) { fi = 0; frac = 0.0; fn = 0; }
+      if (fi > F - 1) { fi = F - 1; frac = 0.0; fn = F - 1; }
+      if (fn > F - 1) fn = F - 1;
+      for (b_band = 0; b_band < ATSA_CRITICAL_BANDS; ++b_band) {
+        double e0 = ENG_RMS(ats_sound->band_energy[b_band][fi], ats_sound->window_size);
+        double e1 = ENG_RMS(ats_sound->band_energy[b_band][fn], ats_sound->window_size);
+        double amp = (e0 + frac * (e1 - e0)) * sparams->ramp;
+        out[n] += amp * ioscilator(1.0, bcent[b_band], 0.0, sparams->sr, &osc[b_band])
+                      * randi(&rb[b_band]);
+      }
+    }
+    free(rb); free(bcent); free(osc);
+  }
+
+  free(re); free(im); free(hann); free(nrm);
+  *out_samps = out;
+  *n_out_samps = todo;
+}
