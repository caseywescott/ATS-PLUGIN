 ////////////////////////////////////////////////////////////////////
 /////////THIS IS THE MAIN SYNTHESIS LOOP////////////////////////////
 ////////////////////////////////////////////////////////////////////
+/* ATSA_PARTIAL_FREE_BANDS: split one frame's residual between the partials
+ * and the bands.  A band holding at least one active partial gives its energy
+ * to those partials, amplitude-weighted (the band_energy_to_res model); a band
+ * with no active partial keeps its energy as band noise.  The legacy combined
+ * synthesis played only the partial share, so the energy of partial-free
+ * bands (noise above the highest partial, or between partials) was silent.
+ * Membership is by each partial's own frequency in this frame, not a walk
+ * that assumes partials stay sorted by frequency, and the result goes into
+ * caller buffers rather than ats_sound->res, so a render never mutates the
+ * (possibly shared) sound. */
+static void atsa_frame_residual_split(const ATS_SOUND *s, int frame, int *band_of,
+                                      double *res_row, double *band_row)
+{
+  double sum[ATSA_CRITICAL_BANDS];
+  int k, b;
+  for (b = 0; b < ATSA_CRITICAL_BANDS; ++b) {
+    sum[b] = 0.0;
+    band_row[b] = s->band_energy[b][frame];
+  }
+  for (k = 0; k < s->partials; ++k) {
+    const double a = s->amp[k][frame], fq = s->frq[k][frame];
+    res_row[k] = 0.0;
+    band_of[k] = -1;
+    if (!(a > 0.0) || !(fq > 0.0))
+      continue;
+    for (b = 0; b < ATSA_CRITICAL_BANDS; ++b)
+      if (fq >= ATSA_CRITICAL_BAND_EDGES[b] && fq < ATSA_CRITICAL_BAND_EDGES[b + 1]) {
+        band_of[k] = b;
+        sum[b] += a;
+        break;
+      }
+  }
+  for (k = 0; k < s->partials; ++k) {
+    b = band_of[k];
+    if (b >= 0 && sum[b] > 0.0)
+      res_row[k] = s->amp[k][frame] * s->band_energy[b][frame] / sum[b];
+  }
+  for (b = 0; b < ATSA_CRITICAL_BANDS; ++b)
+    if (sum[b] > 0.0)
+      band_row[b] = 0.0;
+}
