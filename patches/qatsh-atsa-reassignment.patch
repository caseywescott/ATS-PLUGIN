+/* reassign_frq
+ * ============
+ * Auger-Flandrin frequency reassignment at an integer fft bin:
+ *   f_hat = bin*fft_mag + (sr/2pi) * Im( X_Dh / X_h )
+ * where X_h is the analysis-window spectrum and X_Dh the derivative-window
+ * spectrum. The correction sign is + (not the textbook -) because qatsh's
+ * fft(...,1) uses the +j convention, returning the conjugate of the
+ * -j-convention spectrum (see to_polar's atan2(-y, x)). Validated in
+ * tests/estimator_accuracy_test.c: ~29x lower worst-case frequency error
+ * than parabolic in the unpadded regime. Returns -1.0 on a null peak bin.
+ */
+static double reassign_frq(ATS_FFT *h, ATS_FFT *dh, int bin)
+{
+  double fr = h->fdr[bin],  fi = h->fdi[bin];
+  double gr = dh->fdr[bin], gi = dh->fdi[bin];
+  double denom = fr*fr + fi*fi;
+  double fft_mag = (double)h->rate / (double)h->size;
+  if (denom <= 0.0) return -1.0;
+  return (double)bin * fft_mag + ((double)h->rate / TWOPI) * ((gi*fr - gr*fi) / denom);
+}
