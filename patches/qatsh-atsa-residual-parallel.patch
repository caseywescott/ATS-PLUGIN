+/* ATSA_PARALLEL: read-only context shared by every residual-analysis worker. */
+typedef struct {
+  double **res;            /* res[0] = residual samples */
+  int res_len, N, M, M_2, st_pt, hop, bands;
+  double norm, threshold;
+  const int *band_limits;
+  double **band_arr;       /* output: band_arr[band][frame] */
+  int rate;
+} ResAnaCtx;
+
+/* ATSA_PARALLEL: window, FFT and band-energy one residual frame; writes only
+ * column frame_n of band_arr, so frames may run concurrently. */
+static void res_ana_one_frame(const ResAnaCtx *c, ATS_FFT *fft_struct,
+                              double *band_energy, int frame_n)
+{
+  int i, k, filptr = frame_n * c->hop - c->M_2;
+  for (i = 0; i < c->N; i++) { fft_struct->fdr[i] = 0.0; fft_struct->fdi[i] = 0.0; }
+  for (k = 0; k < c->M; k++) {
+    if (filptr >= 0 && filptr < c->res_len)
+      fft_struct->fdr[(k + c->st_pt) % c->N] = c->res[0][filptr];
+    filptr++;
+  }
+  fft(fft_struct->fdr, fft_struct->fdi, fft_struct->size, 1);
+  residual_compute_band_energy(fft_struct, (int *)c->band_limits, c->bands, band_energy, c->norm);
+  for (k = 0; k < ATSA_CRITICAL_BANDS; k++) {
+    if (!isfinite(band_energy[k]) || band_energy[k] < c->threshold)
+      c->band_arr[k][frame_n] = 0.0;
+    else
+      c->band_arr[k][frame_n] = band_energy[k];
+  }
+}
+
+static void res_ana_scratch_alloc(const ResAnaCtx *c, ATS_FFT *fft_struct, double **band_energy)
+{
+  fft_struct->size = c->N;
+  fft_struct->rate = c->rate;
+  fft_struct->fdr = (double *)malloc(c->N * sizeof(double));
+  fft_struct->fdi = (double *)malloc(c->N * sizeof(double));
+  *band_energy = (double *)malloc(ATSA_CRITICAL_BANDS * sizeof(double));
+}
+
+static void res_ana_scratch_free(ATS_FFT *fft_struct, double *band_energy)
+{
+  free(fft_struct->fdr);
+  free(fft_struct->fdi);
+  free(band_energy);
+}
+
+#ifdef ATSA_HAVE_THREADS
+typedef struct { const ResAnaCtx *ctx; int start, end; } ResAnaJob;
+
+static void *res_ana_worker(void *arg)
+{
+  ResAnaJob *j = (ResAnaJob *)arg;
+  ATS_FFT fft_struct;
+  double *band_energy;
+  int f;
+  res_ana_scratch_alloc(j->ctx, &fft_struct, &band_energy);
+  for (f = j->start; f < j->end; f++)
+    res_ana_one_frame(j->ctx, &fft_struct, band_energy, f);
+  res_ana_scratch_free(&fft_struct, band_energy);
+  return NULL;
+}
+#endif
+
+/* ATSA_PARALLEL: run the per-frame residual analysis over all frames, using as
+ * many worker threads as there are cores (serial fallback otherwise). */
+static void res_ana_run(const ResAnaCtx *c, int frames)
+{
+#ifdef ATSA_HAVE_THREADS
+  long ncpu = sysconf(_SC_NPROCESSORS_ONLN);
+  int nthreads = (ncpu > 1) ? (int)ncpu : 1;
+  if (nthreads > frames) nthreads = frames;
+  if (nthreads > 32) nthreads = 32;
+  if (nthreads > 1) {
+    pthread_t *tids = (pthread_t *)malloc(nthreads * sizeof(pthread_t));
+    ResAnaJob *jobs = (ResAnaJob *)malloc(nthreads * sizeof(ResAnaJob));
+    int t, base = frames / nthreads, rem = frames % nthreads, next = 0;
+    for (t = 0; t < nthreads; t++) {
+      int cnt = base + (t < rem ? 1 : 0);
+      jobs[t].ctx = c; jobs[t].start = next; jobs[t].end = next + cnt;
+      next += cnt;
+    }
+    for (t = 0; t < nthreads; t++) pthread_create(&tids[t], NULL, res_ana_worker, &jobs[t]);
+    for (t = 0; t < nthreads; t++) pthread_join(tids[t], NULL);
+    free(jobs); free(tids);
+    return;
+  }
+#endif
+  {
+    ATS_FFT fft_struct;
+    double *band_energy;
+    int f;
+    res_ana_scratch_alloc(c, &fft_struct, &band_energy);
+    for (f = 0; f < frames; f++)
+      res_ana_one_frame(c, &fft_struct, band_energy, f);
+    res_ana_scratch_free(&fft_struct, band_energy);
+  }
+}
