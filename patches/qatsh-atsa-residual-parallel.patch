+/* ATSA_PARALLEL: read-only context shared by every residual-compute worker. */
+typedef struct {
+  double *fil;
+  int fil_len;
+  ATS_SOUND *sound;
+  int *win_samps;
+  int partials, frm_samps;
+  double mag;
+  double *res0, *res1;     /* outputs: residual and synthesis channels */
+} ResComputeCtx;
+
+/* ATSA_PARALLEL: compute one residual frame frm (1..frames-1). Reads only
+ * read-only context and writes the disjoint output slice [(frm-1)*frm_samps,
+ * frm*frm_samps), so frames may run concurrently. */
+static void res_compute_one_frame(const ResComputeCtx *c, double *in_buff,
+                                  double *synth_buff, int frm)
+{
+  int i, par, frm_1 = frm - 1, frm_2 = frm, frm_samps = c->frm_samps;
+  int out_smp = frm_1 * frm_samps;
+  double a1, a2, f1, f2, p1, p2;
+  ATS_SOUND *sound = c->sound;
+  for (i = 0; i < frm_samps; i++) { in_buff[i] = 0.0; synth_buff[i] = 0.0; }
+  read_frame(c->fil, c->fil_len, c->win_samps[frm_1], c->win_samps[frm_2], in_buff);
+  for (par = 0; par < c->partials; par++) {
+    a1 = sound->amp[par][frm_1];
+    a2 = sound->amp[par][frm_2];
+    f1 = sound->frq[par][frm_1] * c->mag;   /* frequency in radians per sample */
+    f2 = sound->frq[par][frm_2] * c->mag;
+    p1 = sound->pha[par][frm_1];
+    p2 = sound->pha[par][frm_2];
+    if (!(a1 <= 0.0 && a2 <= 0.0)) {
+      if (a1 <= 0.0) {
+        f1 = f2;
+        p1 = p2 - (f2 * frm_samps);
+        while (p1 > PI) { p1 -= TWOPI; }
+        while (p1 < (PI * -1)) { p1 += TWOPI; }
+      }
+      if (a2 <= 0.0) {
+        f2 = f1;
+        p2 = p1 + (f1 * frm_samps);
+        while (p2 > PI) { p2 -= TWOPI; }
+        while (p2 < (PI * -1)) { p2 += TWOPI; }
+      }
+      synth_buffer(a1, a2, f1, f2, p1, p2, synth_buff, frm_samps);
+    }
+  }
+  for (i = 0; i < frm_samps; i++) {
+    double synth = synth_buff[i];
+    c->res0[out_smp] = in_buff[i] - synth;
+    c->res1[out_smp] = synth;
+    out_smp++;
+  }
+}
+
+#ifdef ATSA_HAVE_THREADS
+typedef struct { const ResComputeCtx *ctx; int start, end; } ResComputeJob;
+
+static void *res_compute_worker(void *arg)
+{
+  ResComputeJob *j = (ResComputeJob *)arg;
+  int frm_samps = j->ctx->frm_samps, f;
+  double *in_buff = (double *)malloc(frm_samps * sizeof(double));
+  double *synth_buff = (double *)malloc(frm_samps * sizeof(double));
+  for (f = j->start; f < j->end; f++)
+    res_compute_one_frame(j->ctx, in_buff, synth_buff, f);
+  free(in_buff);
+  free(synth_buff);
+  return NULL;
+}
+#endif
+
+/* ATSA_PARALLEL: run residual computation over frames [1, frames), using as many
+ * worker threads as there are cores (serial fallback otherwise). */
+static void res_compute_run(const ResComputeCtx *c, int frames)
+{
+  int work = frames - 1;   /* frames 1..frames-1 */
+  if (work <= 0) return;
+#ifdef ATSA_HAVE_THREADS
+  {
+    long ncpu = sysconf(_SC_NPROCESSORS_ONLN);
+    int nthreads = (ncpu > 1) ? (int)ncpu : 1;
+    if (nthreads > work) nthreads = work;
+    if (nthreads > 32) nthreads = 32;
+    if (nthreads > 1) {
+      pthread_t *tids = (pthread_t *)malloc(nthreads * sizeof(pthread_t));
+      ResComputeJob *jobs = (ResComputeJob *)malloc(nthreads * sizeof(ResComputeJob));
+      int t, base = work / nthreads, rem = work % nthreads, next = 1; /* frames start at 1 */
+      for (t = 0; t < nthreads; t++) {
+        int cnt = base + (t < rem ? 1 : 0);
+        jobs[t].ctx = c; jobs[t].start = next; jobs[t].end = next + cnt;
+        next += cnt;
+      }
+      for (t = 0; t < nthreads; t++) pthread_create(&tids[t], NULL, res_compute_worker, &jobs[t]);
+      for (t = 0; t < nthreads; t++) pthread_join(tids[t], NULL);
+      free(jobs); free(tids);
+      return;
+    }
+  }
+#endif
+  {
+    int frm_samps = c->frm_samps, f;
+    double *in_buff = (double *)malloc(frm_samps * sizeof(double));
+    double *synth_buff = (double *)malloc(frm_samps * sizeof(double));
+    for (f = 1; f < frames; f++)
+      res_compute_one_frame(c, in_buff, synth_buff, f);
+    free(in_buff);
+    free(synth_buff);
+  }
+}
