 #include <stdio.h>
 #include <stdlib.h>
 
+/* ATSA_PARALLEL: the residual critical-band analysis is independent per frame
+ * (each frame windows a disjoint span of the residual, runs its own FFT and
+ * writes only its own column of band_arr), so it is parallelized across cores.
+ * POSIX threads where available; Windows builds fall back to the serial path. */
+#if !defined(_WIN32)
+#define ATSA_HAVE_THREADS 1
+#include <pthread.h>
+#include <unistd.h>
+#endif
+
 #define ATSA_RES_MIN_FFT_SIZE 4096
 #define ATSA_RES_PAD_FACTOR 2
 #define MAG_SQUARED(re, im, norm) (norm * (re*re+im*im))
