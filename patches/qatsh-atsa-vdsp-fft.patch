+#ifdef __APPLE__
+/* ATSA_VDSP_FFT: cached vDSP double-precision radix-2 setups, one per log2(n).
+ * Setup creation is relatively expensive, so it is memoized; the mutex makes
+ * lazy creation safe when the analysis frame loop is parallelized. */
+#define ATSA_VDSP_MAXLOG2 28
+static FFTSetupD atsa_vdsp_setups[ATSA_VDSP_MAXLOG2 + 1];
+static pthread_mutex_t atsa_vdsp_mtx = PTHREAD_MUTEX_INITIALIZER;
+
+static FFTSetupD atsa_vdsp_get_setup(int log2n)
+{
+  FFTSetupD s;
+  if (log2n < 1 || log2n > ATSA_VDSP_MAXLOG2) return NULL;
+  s = atsa_vdsp_setups[log2n];
+  if (s != NULL) return s;
+  pthread_mutex_lock(&atsa_vdsp_mtx);
+  s = atsa_vdsp_setups[log2n];
+  if (s == NULL) {
+    s = vDSP_create_fftsetupD((vDSP_Length)log2n, kFFTRadix2);
+    atsa_vdsp_setups[log2n] = s;
+  }
+  pthread_mutex_unlock(&atsa_vdsp_mtx);
+  return s;
+}
+#endif
