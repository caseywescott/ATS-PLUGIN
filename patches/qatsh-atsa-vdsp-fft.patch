+      DSPDoubleSplitComplex z;
+      z.realp = rl;
+      z.imagp = im;
+      vDSP_fft_zipD(setup, &z, 1, (vDSP_Length)log2n,
+                    (is == 1) ? kFFTDirection_Inverse : kFFTDirection_Forward);
+      return;
+    }
+  }
+#endif
+  fft_scalar(rl, im, n, is);
+}
