 void fft(double *rl, double *im, int n, int is)
 {
+#ifdef __APPLE__
+  if (n > 0 && (n & (n - 1)) == 0) { /* power of two */
+    int log2n = (int)(log((double)n) / log(2.0) + 0.5);
+    FFTSetupD setup = atsa_vdsp_get_setup(log2n);
