+    if (anargs->multi_res && crossover_bin >= anargs->lowest_bin) {
+      int lfilptr = win_samps[frame_n] - lM_2;
+      ATS_PEAK *lpeaks = NULL;
+      int lpeaks_size = 0;
+      for (k=0; k<anargs->fft_size; k++) lfft_struct.fdr[k] = lfft_struct.fdi[k] = 0.0f;
