--- a/src/atsa/atsa.h
+++ b/src/atsa/atsa.h
@@ -45,6 +45,19 @@ extern "C" {
 /* hop size proportional to window size (ratio) */
 #define  ATSA_HSIZE 0.25
 
+/* ATSA_MULTIRES: multi-resolution analysis front-end.
+ * 0 = single-resolution (default, bit-identical to legacy). When enabled, a
+ * second, longer analysis window resolves the low band (better frequency
+ * resolution for closely-spaced bass partials) while the default window keeps
+ * its time resolution on the high band (sharper attacks). Peaks below the
+ * crossover come from the long window, peaks above from the default window;
+ * the bands are disjoint by FFT bin so the merge needs no extra de-duplication. */
+#define  ATSA_MULTIRES 0
+/* long-window size multiplier (relative to win_size) for the low band */
+#define  ATSA_MRWINMULT 2.0
+/* crossover frequency (Hz): below -> long window, above -> default window */
+#define  ATSA_MRCROSS 500.0
+
 /* lowest magnitude for peaks (amp) */
 #define  ATSA_LMAG  -60.0
 
@@ -128,6 +141,10 @@ typedef struct {
   double SMR_cont;
   double SMR_thres;
   double min_seg_SMR;
+  /* ATSA_MULTIRES: multi-resolution analysis front-end (0 = off, legacy) */
+  int multi_res;
+  double mr_win_mult;
+  double mr_crossover;
   /* parameters computed from command line */
   int first_smp;
   int cycle_smp;
